#!/usr/bin/env bash
# Toggle lazygit in a tmux popup

popup_name="__lazygit__"

if [ "$(tmux display-message -p -F "#{session_name}")" = "$popup_name" ]; then
    tmux detach-client
else
    tmux display-popup -d '#{pane_current_path}' -w 90% -h 90% -E "tmux attach -t $popup_name || tmux new -s $popup_name lazygit"
fi
